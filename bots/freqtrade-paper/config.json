{
  "$schema": "https://schema.freqtrade.io/schema.json",
  "bot_name": "Telmo - Paper 250 EUR",
  "dry_run": true,
  "dry_run_wallet": 250,
  "stake_currency": "EUR",
  "stake_amount": 30,
  "tradable_balance_ratio": 1.0,
  "max_open_trades": 3,
  "trading_mode": "spot",
  "margin_mode": "",
  "timeframe": "15m",
  "fee": 0.008,
  "cancel_open_orders_on_exit": false,
  "initial_state": "running",
  "force_entry_enable": false,
  "ignore_buying_expired_candle_after": 600,
  "unfilledtimeout": {"entry": 5, "exit": 5, "unit": "minutes"},
  "entry_pricing": {"price_side": "other", "use_order_book": true, "order_book_top": 1},
  "exit_pricing": {"price_side": "other", "use_order_book": true, "order_book_top": 1},
  "order_types": {
    "entry": "market",
    "exit": "market",
    "stoploss": "market",
    "stoploss_on_exchange": false
  },
  "order_time_in_force": {"entry": "GTC", "exit": "GTC"},
  "exchange": {
    "name": "kraken",
    "key": "",
    "secret": "",
    "password": "",
    "enable_ws": false,
    "ccxt_config": {"enableRateLimit": true, "timeout": 20000, "requests_trust_env": true, "options": {"include_OS_certificates": true}},
    "ccxt_async_config": {"enableRateLimit": true, "timeout": 20000, "aiohttp_trust_env": true},
    "pair_whitelist": ["BTC/EUR", "ETH/EUR", "SOL/EUR", "XRP/EUR", "ADA/EUR", "LTC/EUR", "DOT/EUR", "LINK/EUR"],
    "pair_blacklist": []
  },
  "pairlists": [{"method": "StaticPairList"}],
  "telegram": {"enabled": false, "token": "", "chat_id": ""},
  "api_server": {
    "enabled": true,
    "listen_ip_address": "127.0.0.1",
    "listen_port": 8080,
    "verbosity": "error",
    "enable_openapi": false,
    "CORS_origins": [],
    "username": "telmo"
  },
  "internals": {"process_throttle_secs": 10, "heartbeat_interval": 60},
  "dataformat_ohlcv": "feather",
  "strategy": "PaperTrend250"
}
